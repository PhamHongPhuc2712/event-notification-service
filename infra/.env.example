# Copy to infra/.env and change the values. infra/.env is gitignored.
POSTGRES_DB=notifications
POSTGRES_USER=notifications
POSTGRES_PASSWORD=change-me
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Secret that signs outgoing webhooks (Standard Webhooks format: whsec_ + base64 of 24-64 random bytes).
# Generate one with: python -c "import secrets,base64;print('whsec_'+base64.b64encode(secrets.token_bytes(32)).decode())"
WEBHOOK_SIGNING_SECRET=change-me
